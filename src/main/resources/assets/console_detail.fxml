<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<VBox fx:id="consoleDetailRoot" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.111" spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20;" fx:controller="com.ejercicios.ControllerConsoleDetail">
    <!-- Imagen -->
    <StackPane fx:id="imageContainer" prefWidth="180" maxWidth="180" minWidth="180" prefHeight="120" maxHeight="120" minHeight="120" style="-fx-background-color: #F5F5F5; -fx-border-radius: 8; -fx-background-radius: 8;" alignment="CENTER">
        <ImageView fx:id="consoleImage" fitWidth="160" fitHeight="100" preserveRatio="true" smooth="true"/>
    </StackPane>
    
    <!-- Nombre -->
    <Label fx:id="consoleNameLabel" text="Console Name" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
    
    <!-- Lanzamiento -->
    <Label fx:id="consoleDateLabel" text="Release Date" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
    
    <!-- Procesador -->
    <Label fx:id="consoleProcessorLabel" text="Processor" style="-fx-font-size: 14px; -fx-text-fill: #1A1A2E; -fx-font-family: monospace;"/>
    
    <!-- Color -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Color:" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #333;"/>
        <Region fx:id="consoleColorBadge" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20" minWidth="20" minHeight="20" style="-fx-border-color: #DDD; -fx-border-width: 1;"/>
        <Label fx:id="consoleColorLabel" text="Color" style="-fx-font-size: 13px; -fx-text-fill: #1A1A2E;"/>
    </HBox>
    
    <!-- Unidades vendidas -->
    <Label fx:id="consoleUnitsLabel" text="Units Sold" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
</VBox>