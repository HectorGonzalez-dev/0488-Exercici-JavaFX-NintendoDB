<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.111" fx:controller="com.ejercicios.Controller">
    <top>
        <HBox style="-fx-background-color: #0066CC; -fx-padding: 15px;" alignment="CENTER" prefHeight="60">
            <Label text="Nintendo DB" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <BorderPane fx:id="contentArea">
            <left>
                <!-- Left side: Category list - fixed width -->
                <VBox spacing="10" style="-fx-padding: 15 15 15 15; -fx-background-color: #F8F8F8;" minWidth="250" prefWidth="250" maxWidth="250">
                    <HBox alignment="CENTER_LEFT">
                        <ComboBox fx:id="categoryComboBox" prefWidth="200"/>
                    </HBox>
                    <ScrollPane fx:id="contentScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox fx:id="scrollContent" spacing="10" style="-fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </left>
            <center>
                <!-- Right side: Detail view -->
                <BorderPane fx:id="detailArea" style="-fx-padding: 15 15 15 15; -fx-background-color: #FAFAFA;">
                    <center>
                        <ScrollPane fx:id="detailScrollPane" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox fx:id="detailContent" spacing="15" style="-fx-background-color: transparent;"/>
                        </ScrollPane>
                    </center>
                </BorderPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>